# Copy this file to .env in the project root and fill in your own values.
# The server reads .env on start. A real environment variable wins over it,
# for example: ADMIN_PASSWORD=something npm start
#
# .env is ignored by git, so nothing in it reaches the repository.
#
# Check the settings without starting the site: npm run db:check

# Organizer sign in for /admin. With no password set here, the server creates
# a random one on first start and prints it once in the terminal.
ADMIN_USERNAME=subhan
ADMIN_PASSWORD=

# ---------------------------------------------------------------- Supabase
# In Supabase: Connect > Session pooler > copy the URI, then replace
# [YOUR-PASSWORD] with the database password you chose when creating the
# project. The whole line goes in, password included.
#
# Use the Session pooler, not the direct connection (which is IPv6 only on the
# free plan) and not the transaction pooler (which has no prepared statements).
#
# If the password contains any of &, #, ? or a space, replace each one with its
# percent encoded form, for example & becomes %26.
#
# DB_URL=postgresql://postgres.projectref:password@aws-0-region.pooler.supabase.com:5432/postgres

# Optional, for a provider that gives the parts separately. A connection line
# describes the whole connection, so DB_URL wins over these when both are set.
# DB_HOST=
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=
# DB_PASSWORD=

# Optional. Encryption is on by default for any host other than localhost.
# DB_SSL=true
# Optional. Point this at the server certificate to verify the connection as
# well as encrypt it. Supabase provides it under Connect > SSL configuration.
# DB_SSL_CA=./prod-ca-2021.crt

# ------------------------------------------------------------- settings
# Optional. Leave unset to derive the session key from the organizer password.
# SESSION_SECRET=change-me-to-a-long-random-value

# Optional. Uncomment to change the defaults.
# PORT=3000
# HOST=0.0.0.0
