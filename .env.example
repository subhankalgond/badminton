# Copy this file to .env in the project root and fill in your own values.
# The server reads .env on start. A real environment variable wins over it,
# for example: ADMIN_PASSWORD=something npm start
#
# .env is ignored by git, so nothing in it reaches the repository.

# Organizer sign in for /admin. With no password set here, the server creates
# a random one on first start and prints it once in the terminal.
ADMIN_USERNAME=subhan
ADMIN_PASSWORD=

# Optional. Uncomment to change the defaults.
# PORT=3000
# HOST=0.0.0.0
# SESSION_SECRET=change-me
# DATA_DIR=./data
# UPLOAD_DIR=./uploads
# DB_FILE=./data/app.db
